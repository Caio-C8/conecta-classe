{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DB_USER",
    "DB_PASSWORD",
    "DB_NAME",
    "DB_PORT",
    "DATABASE_URL",
    "JWT_SECRETO",
    "URL_FRONTEND_CORS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_API_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:studio": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "db:seed:frequencia": {
      "cache": false
    },
    "db:seed:evento": {
      "cache": false
    },
    "db:seed:rendimento": {
      "cache": false
    },
    "db:seed:professor": {
      "cache": false
    },
    "db:seed:usuarios": {
      "cache": false
    },
    "db:seed:encerrar-turma": {
      "cache": false
    }
  }
}
