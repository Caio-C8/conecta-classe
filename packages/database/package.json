{
  "name": "@repo/database",
  "version": "1.0.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:seed": "dotenv -e ../../.env -- prisma db seed",
    "db:seed:frequencia": "dotenv -e ../../.env -- tsx prisma/seedFrequencia.ts",
    "db:seed:evento": "dotenv -e ../../.env -- tsx prisma/seedEvento.ts",
    "db:seed:rendimento": "dotenv -e ../../.env -- tsx prisma/seedRendimento.ts",
    "db:seed:professor": "dotenv -e ../../.env -- tsx prisma/seedProfessor.ts",
    "db:seed:usuarios": "dotenv -e ../../.env -- tsx prisma/seedUsuarios.ts",
    "db:seed:encerrar-turma": "dotenv -e ../../.env -- tsx prisma/seedEncerrarTurma.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.5.0",
    "@prisma/client": "^5.22.0",
    "@prisma/config": "^7.5.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.37",
    "prisma": "^5.22.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
