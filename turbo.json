{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:studio": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "db:seed:frequencia": {
      "cache": false
    },
    "db:seed:evento": {
      "cache": false
    },
    "db:seed:rendimento": {
      "cache": false
    },
    "db:seed:professor": {
      "cache": false
    },
    "db:seed:usuarios": {
      "cache": false
    }
  }
}
